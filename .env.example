# Copy this file to .env and fill in your values, then run start_windows.bat
# (or start_mac_linux.sh) to launch the app locally.

DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
SECRET_KEY=any-long-random-string

# Optional: Tally ledger names (must match your Tally company exactly)
# TALLY_SALES_LEDGER=Sales
# TALLY_IGST_LEDGER=Output IGST 18%
# TALLY_DELIVERY_LEDGER=Delivery Charges
# TALLY_ROUNDOFF_LEDGER=Round Off
# TALLY_VOUCHER_TYPE=Sales
# TALLY_COMPANY_NAME=   # leave blank to import into whichever company is open
